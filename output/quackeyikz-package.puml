@startuml
skinparam classAttributeIconSize 0

package ChestShop {
class ChestShop {
  -name: String
  -item: Item
  -count: int
  -price: int
  -ownerName: String
  -isSelling: boolean
  --
  +ChestShop(name: String, ownerName: String)
  +ChestShop(name: String, item: Item, count: int, price: int, owner: String)
  +getName(): String
  +setName(name: String): void
  +getItem(): Item
  +setItem(item: Item): void
  +getCount(): int
  +setCount(count: int): void
  +getPrice(): int
  +setPrice(price: int): void
  +getOwnerName(): String
  +setOwnerName(ownerName: String): void
  +isIsSelling(): boolean
  +toggleSell(): void
}
}

package Effect {
class Consequence {
  -name: String
  -tier: int
  -description: String
  --
  +Consequence(name: String)
  +Consequence(name: String, tier: int)
  +Consequence(name: String, tier: int, description: String)
  +getName(): String
  +setName(name: String): void
  +getTier(): int
  +setTier(tier: int): void
  +getDescription(): String
  +setDescription(description: String): void
}

class Effect {
  -type: String
  --
  +Effect()
  +Effect(name: String)
  +Effect(name: String, type: String)
  +Effect(name: String, type: String, description: String)
  +Effect(name: String, tier: int, type: String, description: String)
  +getType(): String
  +setType(type: String): void
}

class Enchantment {
  -expCost: int
  --
  +Enchantment()
  +Enchantment(name: String)
  +Enchantment(name: String, exp: int)
  +Enchantment(name: String, exp: int, description: String)
  +Enchantment(name: String, tier: int, exp: int, description: String)
  +getExpCost(): int
  +setExpCost(expCost: int): void
}
}

package Interfaces {
interface DataManager {
  ~commands(a: String[], t: List<T>): T
  ~up(): void
  ~down(): void
  ~insert(t: T): void
  ~delete(t: T): void
  ~find(s: String): T
}

interface Usable {
  ~use(): void
}
}

package Item {
class Item {
  -name: String
  -type: String
  -stackSize: int
  --
  +Item(name: String)
  +Item(name: String, type: String)
  +Item(name: String, type: String, stackSize: int)
  +getName(): String
  +setName(name: String): void
  +getType(): String
  +setType(type: String): void
  +getStackSize(): int
  +setStackSize(stackSize: int): void
}

class ItemConsumable {
  ~effects: List<Effect> = new ArrayList<>()
  --
  +ItemConsumable(name: String)
  +ItemConsumable(name: String, type: String, effect: Effect)
  +ItemConsumable(name: String, type: String, stackSize: int, effect: Effect)
  +getEffects(): List<Effect>
  +setEffects(effects: List<Effect>): void
  +addEffect(effect: Effect): void
  +use(): void
}

class ItemUsable {
  -durability: int
  -enchantment: Enchantment
  --
  +ItemUsable(name: String)
  +ItemUsable(name: String, type: String, stackSize: int)
  +ItemUsable(name: String, type: String, enchantment: Enchantment)
  +ItemUsable(name: String, type: String, stackSize: int, durability: int)
  +ItemUsable(name: String, type: String, stackSize: int, durability: int, enchantment: Enchantment)
  +getDurability(): int
  +setDurability(durability: int): void
  +getEnchantment(): Enchantment
  +setEnchantment(enchantment: Enchantment): void
  +use(): void
}
}

class Main {
  +{static} BOLD: String = "\u001B[1m"
  +{static} RESET: String = "\u001B[0m"
  +{static} RED: String = "\u001B[31m"
  +{static} GREEN: String = "\u001B[32m"
  +{static} YELLOW: String = "\u001B[33m"
  +{static} BLUE: String = "\u001B[34m"
  +{static} PURPLE: String = "\u001B[35m"
  +{static} CYAN: String = "\u001B[36m"
  +{static} enchantmentsList: List<Enchantment> = new ArrayList<>()
  +{static} effectsList: List<Effect> = new ArrayList<>()
  +{static} itemsList: List<Item> = new ArrayList<>()
  +{static} playersList: List<Player> = new ArrayList<>()
  +{static} chestshopsList: List<ChestShop> = new ArrayList<>()
  --
  +{static} main(args: String[]): void
  +{static} mainCommands(input: String): void
  +{static} chat(input: String): void
  +{static} welcomeBanner(): void
  +{static} tutorial(): void
  +{static} delay(time: int): void
}

package Manager {
class ChestShopsManager {
  +commands(args: String[], chestshopsList: List<ChestShop>): ChestShop
  +up(): void
  +down(): void
  +insert(chest: ChestShop): void
  +delete(chest: ChestShop): void
  +find(s: String): ChestShop
  +queryAll(): void
  +itemTableUpdate(item: Item): void
  +help(): void
}

class DBConnection {
  -{static} JDBC: String
  -{static} USER: String
  -{static} PASS: String
  --
  +{static} getConnection(): Connection
  +{static} main(args: String[]): void
}

class EffectsManager {
  +commands(args: String[], effectsList: List<Effect>): Effect
  +up(): void
  +down(): void
  +insert(eff: Effect): void
  +delete(eff: Effect): void
  +find(name: String): Effect
  +help(): void
}

class EnchantmentsManager {
  +commands(args: String[], enchantmentsList: List<Enchantment>): Enchantment
  +up(): void
  +down(): void
  +insert(enchantment: Enchantment): void
  +delete(enchantment: Enchantment): void
  +find(s: String): Enchantment
  +create_initial_enchantments(): List<Enchantment>
  +help(): void
}

class ItemsManager {
  +commands(args: String[], itemsList: List<Item>): Item
  +up(): void
  +down(): void
  +insert(item: Item): void
  +delete(item: Item): void
  +find(s: String): Item
  +help(): void
}

class PlayersManager {
  +commands(args: String[], playersList: List<Player>): Player
  +up(): void
  +down(): void
  +insert(player: Player): void
  +delete(player: Player): void
  +find(s: String): Player
  +help(): void
}
}

package Player {
class Player {
  -name: String
  -items: List<Item>
  --
  +Player(name: String, items: Item)
  +getName(): String
  +setName(name: String): void
  +getItems(): List<Item>
  +addItems(item: Item): void
}
}

ChestShop *-- Item
Effect --|> Consequence
Enchantment --|> Consequence
ItemConsumable --|> Item
ItemConsumable ..|> Usable
ItemConsumable o-- Effect
ItemUsable --|> Item
ItemUsable ..|> Usable
ItemUsable *-- Enchantment
Main o-- Enchantment
Main o-- Effect
Main o-- Item
Main o-- Player
Main o-- ChestShop
ChestShopsManager ..|> DataManager
ChestShopsManager ..> ChestShop
ChestShopsManager ..> Item
EffectsManager ..|> DataManager
EffectsManager ..> Effect
EnchantmentsManager ..|> DataManager
EnchantmentsManager ..> Enchantment
ItemsManager ..|> DataManager
ItemsManager ..> Item
PlayersManager ..|> DataManager
PlayersManager ..> Player
Player o-- Item
@enduml